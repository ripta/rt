exec cg run -v --format 'T ' -- echo hello
stdout '^T I: cg '
stdout '^T I: prefix='
stdout '^T I: Started echo hello$'
stdout '^T O: hello$'
stdout '^T I: Finished exitcode=0 in [0-9.]+(ns|us|µs|ms|s) cpu=\S+/\S+ \(out=1 err=0\)$'
stdout '^T I: Usage user=\S+ sys=\S+ maxrss=\S+ minflt=\d+ majflt=\d+ nvcsw=\d+ nivcsw=\d+ inblock=\d+ oublock=\d+ source=rusage_children$'
